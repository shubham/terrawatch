-- Task 2 (Plan 5): favorites beyond home — label + point + a per-place alertType (TEXT, safe-parsed
-- by com.yugma.terrawatch.model.FavoriteAlertType.fromStored on the Kotlin side, same "DB stores the
-- raw string, the domain layer owns safe-parsing" split this project already uses for `quake.status`/
-- `quake.sourcesJson` in Quake.sq).
--
-- `favoritePlace`, camelCase — matches this project's own established SQL-identifier convention
-- (every multi-word COLUMN in Quake.sq is already camelCase: `timeMillis`, `depthKm`, `magType`,
-- `updatedAtMillis`, ...; this is simply the first multi-word TABLE name this project has needed).
-- Deliberately NOT `favorite_place` (snake_case): SQLDelight derives a query file's generated row
-- class from the table name by capitalizing only the first letter, not by splitting on underscores
-- (confirmed by actually generating code both ways, not assumed — `favorite_place` produced a real
-- `Favorite_place` row class, an ugly, inconsistent-with-this-file's-own-style identifier for zero
-- benefit, since no test or caller ever references the raw SQL table name string itself).
--
-- NEW TABLE, NO MIGRATION PATH — same accepted gap Quake.sq's own `origin` column/`quake_fetchedAt`
-- index already documented at length (see that file): this project has never added a SQLDelight
-- `.sqm` migration file, so `TerraWatchDb.Schema.version` has stayed 1 since Plan 1, and both real
-- drivers only ever call `Schema.create` — `DriverFactory.jvm.kt` gates it behind `!dbFile.exists()`,
-- and `DriverFactory.android.kt`'s bare `AndroidSqliteDriver(TerraWatchDb.Schema, context, name)`
-- constructor fires `onCreate` only when the underlying db file is missing. This table therefore
-- lands ONLY on a brand-new database file — any already-installed app (including 98bc1cd8's own,
-- from earlier Plan 2-4 verification passes) has no `favoritePlace` table at all until that install
-- is uninstalled and reinstalled. Accepted pre-release, identical reasoning Quake.sq's own notes give:
-- no shipped user base yet, so no real migration is being skipped for anyone.
CREATE TABLE favoritePlace (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  label TEXT NOT NULL,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  alertType TEXT NOT NULL DEFAULT 'ALL'
);

selectAllFavoritePlaces:
SELECT * FROM favoritePlace ORDER BY id ASC;

insertFavoritePlace:
INSERT INTO favoritePlace(label, lat, lon, alertType) VALUES (?, ?, ?, ?);

deleteFavoritePlace:
DELETE FROM favoritePlace WHERE id = ?;

updateFavoritePlaceAlertType:
UPDATE favoritePlace SET alertType = ? WHERE id = ?;

countFavoritePlaces:
SELECT COUNT(*) FROM favoritePlace;
