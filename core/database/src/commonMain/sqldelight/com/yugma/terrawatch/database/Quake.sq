CREATE TABLE quake (
  id TEXT NOT NULL PRIMARY KEY,
  timeMillis INTEGER NOT NULL,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  depthKm REAL,
  mag REAL,
  magType TEXT,
  place TEXT NOT NULL,
  tsunami INTEGER NOT NULL DEFAULT 0,
  felt INTEGER,
  status TEXT NOT NULL,
  sourcesJson TEXT NOT NULL,
  revisionsJson TEXT NOT NULL,
  updatedAtMillis INTEGER NOT NULL,
  fetchedAtMillis INTEGER NOT NULL,
  -- Task 2 (Plan 4), F1 retention ruling (plan-3-exit-conditions.md): which write path produced
  -- this row -- 'feed' (QuakeRepository.refreshFeed's poll), 'archive' (History's loadArchivePage
  -- backfill -- MUST stay protected from pruneOldRows below, per that same F1 note: "History's
  -- 'cached pages browse offline' contract implicitly wants old rows kept"), 'live' (the EMSC
  -- WebSocket collector in startLive), or 'debug' (the long-press debug-inject hook -- already
  -- swept separately and unconditionally by deleteByIdPrefix/purgeDebugQuakes, but also exempted
  -- here so a debug row surviving between purges is never silently pruned as if it were real data).
  -- DEFAULT 'feed' is a schema-level safety net only -- every real write path
  -- (QuakeDao.replace/replaceAndDelete, via QuakeStore's own `origin` parameter) always passes an
  -- explicit value; this is a full `INSERT OR REPLACE ... VALUES ?` row bind, not a partial
  -- column-list insert SQLite's own DEFAULT clause could actually apply to.
  --
  -- Deliberately DB-layer-only, by controller decision: com.yugma.terrawatch.model.Quake (the
  -- domain model DedupeEngine/AlertRuleEngine/every UI screen actually sees) gains NO `origin`
  -- field of its own -- QuakeStore's write methods carry the value instead, and no read method
  -- (byId/recent/pageBefore/pageBetween/strongest/...) ever surfaces it back out. Keeps this a
  -- pure storage/retention concern, not a domain concept every consumer has to learn.
  --
  -- NO MIGRATION PATH for this column -- same accepted gap F2's own index addition already
  -- documented at this table's CREATE INDEX statements below: DriverFactory.jvm.kt's
  -- `!dbFile.exists()` gate and DriverFactory.android.kt's AndroidSqliteDriver (onCreate fires only
  -- when the underlying db file is missing) both mean this column, like that index, only actually
  -- lands on a BRAND-NEW db file. Any already-installed on-device db (including 98bc1cd8's own,
  -- from earlier Plan 2/3/4 verification passes) has no `origin` column at all until that install
  -- is uninstalled and reinstalled -- accepted pre-release, same reasoning F2 already accepted: no
  -- shipped user base yet, so no real migration is being skipped for anyone.
  origin TEXT NOT NULL DEFAULT 'feed'
);

CREATE TABLE meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE INDEX quake_time ON quake(timeMillis DESC);
CREATE INDEX quake_mag ON quake(mag);
-- Final review (F2): lastFetchedAt below is an unindexed full-table MAX() on a hot path
-- (HomeViewModel's cache-driven state loop calls QuakeRepository.lastFetchedAtMillis() on every
-- recentQuakes() emission, i.e. every ingest/live-arrival). See DriverFactory.jvm.kt's exists()
-- gate / AndroidSqliteDriver's own onCreate-only-if-missing semantics for why this only reaches
-- ALREADY-installed on-device DBs via a fresh install, not an in-place upgrade — noted in this
-- commit's body, accepted pre-release.
CREATE INDEX quake_fetchedAt ON quake(fetchedAtMillis);

insertOrReplace:
INSERT OR REPLACE INTO quake VALUES ?;

byId:
SELECT * FROM quake WHERE id = ?;

recent:
SELECT * FROM quake WHERE timeMillis >= ? ORDER BY timeMillis DESC;

pageBefore:
SELECT * FROM quake
WHERE timeMillis < :timeMillis AND (:minMag IS NULL OR mag >= :minMag)
ORDER BY timeMillis DESC LIMIT :limit;

-- Task 5 fix round 1 (Plan 3, review Critical): History's display query needs "everything between
-- this filter's paging cursor and its ceiling", not a count-bounded page — see
-- QuakeRepository.pageBetween's own kdoc for the full story (loadedCount, the field this replaces,
-- desynced from actual cache/cursor state on a filter revisit, an app restart, or an offline
-- restart). No LIMIT: the range itself is the bound, by construction of how HistoryPager advances
-- its cursor — an unbounded row count here would only happen for a filter whose own archive walk
-- has gone extremely deep, which is a real usage pattern this app accepts un-paginated for v1 (see
-- that kdoc's own performance note).
pageBetween:
SELECT * FROM quake
WHERE timeMillis >= :lowerInclusive AND timeMillis < :upperExclusive AND (:minMag IS NULL OR mag >= :minMag)
ORDER BY timeMillis DESC;

countAll:
SELECT COUNT(*) FROM quake;

delete:
DELETE FROM quake WHERE id = ?;

-- Fix Round 1 (I2): purges debug-injected quakes (see HomeViewModel.injectDebugQuake's "debug-"
-- id prefix) without a per-id list — the debug hook can inject an unbounded number of these across
-- a device's lifetime.
deleteByIdPrefix:
DELETE FROM quake WHERE id LIKE :prefix || '%';

-- Task 2 (Plan 4), F1 retention ruling (plan-3-exit-conditions.md carried item): the retention
-- policy that item flagged as needed but unfixed — keep feed/live rows for 30 days, called
-- unconditionally from HomeViewModel.init (alongside purgeDebugQuakes) with cutoffMillis = now -
-- 30d. 'archive' rows are exempt (History's own loadArchivePage kdoc: "cached pages browse
-- offline" implicitly wants old rows kept indefinitely) and so are 'debug' rows (already purged
-- separately, unconditionally, by deleteByIdPrefix — exempting them here too is redundant-but-
-- harmless belt-and-suspenders, not load-bearing). `timeMillis < :cutoffMillis` is strict
-- less-than, so a row exactly AT the cutoff survives this pass (QuakeDaoTest pins this boundary).
pruneOldRows:
DELETE FROM quake WHERE timeMillis < :cutoffMillis AND origin IN ('feed', 'live');

-- Task 2 (Plan 4), M1 torn-write ruling (plan-3-exit-conditions.md carried item): backs both
-- meta_put (a lone call) and QuakeDao.metaPutAll (several calls to this SAME statement, wrapped in
-- one `Transacter.transaction {}` so HomeLocationStore's home_lat/home_lon pair commits together —
-- no separate SQL needed for the "many" case, just this statement invoked more than once inside
-- one transaction instead of each call committing independently).
meta_get:
SELECT value FROM meta WHERE key = ?;

meta_put:
INSERT OR REPLACE INTO meta(key, value) VALUES (?, ?);

lastFetchedAt:
SELECT MAX(fetchedAtMillis) FROM quake;

-- Task 2 (Plan 4), Fix Round 1 (review finding): backs the origin-flip-on-merge protection in
-- QuakeRepository.ingest() -- see QuakeStore.originOf's own kdoc for the full mechanism. A bare
-- scalar read, same shape as meta_get above; returns no row (null, via executeAsOneOrNull on the
-- Kotlin side) when `id` isn't stored, rather than an empty-string/default value that could be
-- mistaken for a real origin.
originOf:
SELECT origin FROM quake WHERE id = ?;

-- Task 3 (Plan 4): AlertDigestWorker's own "what's new since my last run" query -- feed/live rows
-- only (the two origins a live user session or a background poll can ever produce), same eligible
-- set pruneOldRows already exempts archive/debug FROM (there: protects them from deletion; here:
-- excludes them from ever reaching a digest notification at all). Archive rows are History's
-- deep-scroll backfill -- years-old by construction whenever they're paged in -- and debug rows are
-- the long-press dev hook; neither should ever be able to trigger a real alert notification, the
-- identical F5 guard QuakeRepository.loadArchivePage's own `rules = emptyList()` already enforces
-- for the live in-session path.
--
-- Fix Round 1 (I1, review finding): cursor moved from `timeMillis` (the quake's own REPORTED
-- event time, set by the originating agency) to `fetchedAtMillis` (THIS device's own write-clock
-- -- see QuakeDao.toRow's `clock()` call, already indexed by `quake_fetchedAt` above). A
-- timeMillis cursor silently never selected two real cases: a publication-lag quake (USGS/EMSC
-- routinely publish 2-20 minutes after the actual event -- its timeMillis can already be older
-- than a run's own cutoff the FIRST time this device ever sees it), and a magnitude revision on
-- an already-old quake (a later revision re-writes the SAME row -- timeMillis never changes, but
-- fetchedAtMillis does, on every re-write). `fetchedAtMillis` is what actually answers "did this
-- device learn something new since the last run" -- `timeMillis` alone cannot. `ORDER BY
-- timeMillis DESC` is UNCHANGED (still display/event recency, not fetch recency) -- only the
-- WHERE predicate's column changed. `fetchedAtMillis > :sinceMillis` is strict greater-than (a
-- row fetched exactly AT the cutoff was already considered by whichever run first recorded it) --
-- mirrors pruneOldRows' own strict `<` on the opposite side of an analogous boundary value.
--
-- A canonical-id swap on a later merge re-presenting an already-notified event under a new `id`
-- is a SEPARATE concern this query does not handle -- absorbed by AlertDigestWorker's own
-- ring-buffer identifier check (AlertDigestSupport.kt's notifiedIdentifiers/
-- filterFreshAlertEvents), a layer above this read, not by this WHERE clause.
newSince:
SELECT * FROM quake WHERE fetchedAtMillis > :sinceMillis AND origin IN ('feed', 'live') ORDER BY timeMillis DESC;

-- Task 6 (Plan 3): Insights' three aggregates. All three share the same `WHERE timeMillis >=
-- :sinceMillis` window-clip — the caller (QuakeDao) always passes the period's own start-of-day
-- millis, never a raw "now minus N millis" cutoff, so results align exactly on calendar-day
-- boundaries (see QuakeDao.quakesPerDay's own kdoc).
quakesPerDay:
SELECT (timeMillis / 86400000) AS dayBucket, COUNT(*) AS n FROM quake WHERE timeMillis >= :sinceMillis GROUP BY dayBucket ORDER BY dayBucket;

-- Band edges match model/MagnitudeBand.kt's magnitudeBand() exactly (< 3.0 / < 4.5 / < 6.0) —
-- single source of truth for the edges is that Kotlin function; this CASE is the SQL-side mirror
-- of it, not an independent redefinition (QuakeDaoTest pins the two boundary values, 4.5 and 6.0,
-- directly against this query so the two can't silently drift apart).
bandDistribution:
SELECT CASE WHEN mag IS NULL THEN 'UNKNOWN' WHEN mag < 3.0 THEN 'LOW' WHEN mag < 4.5 THEN 'MODERATE' WHEN mag < 6.0 THEN 'STRONG' ELSE 'MAJOR' END AS band, COUNT(*) AS n FROM quake WHERE timeMillis >= :sinceMillis GROUP BY band;

-- Fix round (review Entangled Minor): `ORDER BY mag DESC` alone leaves a tied-magnitude winner
-- unspecified (SQLite gives no ordering guarantee among rows with equal `mag`); `timeMillis DESC`
-- as a secondary key makes it deterministic -- the more recent of a tied pair wins.
strongest:
SELECT * FROM quake WHERE timeMillis >= :sinceMillis AND mag IS NOT NULL ORDER BY mag DESC, timeMillis DESC LIMIT 1;
