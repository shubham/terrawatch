CREATE TABLE quake (
  id TEXT NOT NULL PRIMARY KEY,
  timeMillis INTEGER NOT NULL,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  depthKm REAL,
  mag REAL,
  magType TEXT,
  place TEXT NOT NULL,
  tsunami INTEGER NOT NULL DEFAULT 0,
  felt INTEGER,
  status TEXT NOT NULL,
  sourcesJson TEXT NOT NULL,
  revisionsJson TEXT NOT NULL,
  updatedAtMillis INTEGER NOT NULL,
  fetchedAtMillis INTEGER NOT NULL
);

CREATE TABLE meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE INDEX quake_time ON quake(timeMillis DESC);
CREATE INDEX quake_mag ON quake(mag);

insertOrReplace:
INSERT OR REPLACE INTO quake VALUES ?;

byId:
SELECT * FROM quake WHERE id = ?;

recent:
SELECT * FROM quake WHERE timeMillis >= ? ORDER BY timeMillis DESC;

pageBefore:
SELECT * FROM quake
WHERE timeMillis < :timeMillis AND (:minMag IS NULL OR mag >= :minMag)
ORDER BY timeMillis DESC LIMIT :limit;

-- Task 5 fix round 1 (Plan 3, review Critical): History's display query needs "everything between
-- this filter's paging cursor and its ceiling", not a count-bounded page — see
-- QuakeRepository.pageBetween's own kdoc for the full story (loadedCount, the field this replaces,
-- desynced from actual cache/cursor state on a filter revisit, an app restart, or an offline
-- restart). No LIMIT: the range itself is the bound, by construction of how HistoryPager advances
-- its cursor — an unbounded row count here would only happen for a filter whose own archive walk
-- has gone extremely deep, which is a real usage pattern this app accepts un-paginated for v1 (see
-- that kdoc's own performance note).
pageBetween:
SELECT * FROM quake
WHERE timeMillis >= :lowerInclusive AND timeMillis < :upperExclusive AND (:minMag IS NULL OR mag >= :minMag)
ORDER BY timeMillis DESC;

countAll:
SELECT COUNT(*) FROM quake;

delete:
DELETE FROM quake WHERE id = ?;

-- Fix Round 1 (I2): purges debug-injected quakes (see HomeViewModel.injectDebugQuake's "debug-"
-- id prefix) without a per-id list — the debug hook can inject an unbounded number of these across
-- a device's lifetime.
deleteByIdPrefix:
DELETE FROM quake WHERE id LIKE :prefix || '%';

meta_get:
SELECT value FROM meta WHERE key = ?;

meta_put:
INSERT OR REPLACE INTO meta(key, value) VALUES (?, ?);

lastFetchedAt:
SELECT MAX(fetchedAtMillis) FROM quake;

-- Task 6 (Plan 3): Insights' three aggregates. All three share the same `WHERE timeMillis >=
-- :sinceMillis` window-clip — the caller (QuakeDao) always passes the period's own start-of-day
-- millis, never a raw "now minus N millis" cutoff, so results align exactly on calendar-day
-- boundaries (see QuakeDao.quakesPerDay's own kdoc).
quakesPerDay:
SELECT (timeMillis / 86400000) AS dayBucket, COUNT(*) AS n FROM quake WHERE timeMillis >= :sinceMillis GROUP BY dayBucket ORDER BY dayBucket;

-- Band edges match model/MagnitudeBand.kt's magnitudeBand() exactly (< 3.0 / < 4.5 / < 6.0) —
-- single source of truth for the edges is that Kotlin function; this CASE is the SQL-side mirror
-- of it, not an independent redefinition (QuakeDaoTest pins the two boundary values, 4.5 and 6.0,
-- directly against this query so the two can't silently drift apart).
bandDistribution:
SELECT CASE WHEN mag IS NULL THEN 'UNKNOWN' WHEN mag < 3.0 THEN 'LOW' WHEN mag < 4.5 THEN 'MODERATE' WHEN mag < 6.0 THEN 'STRONG' ELSE 'MAJOR' END AS band, COUNT(*) AS n FROM quake WHERE timeMillis >= :sinceMillis GROUP BY band;

strongest:
SELECT * FROM quake WHERE timeMillis >= :sinceMillis AND mag IS NOT NULL ORDER BY mag DESC LIMIT 1;
