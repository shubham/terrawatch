<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plan 4 Task 4b: package-visibility declarations (Android 11/API 30+ restricts
         PackageManager.getLaunchIntentForPackage/queryIntentActivities/an explicit-package
         ACTION_SEND to only apps declared here, regardless of what's actually installed) for the 3
         quick-share targets - com.yugma.terrawatch.share.isPackageInstalled/sharePackaged both need
         this, or every check silently reads "not installed" on API 30+ even when the app IS
         present. Plain <package> entries (not an <intent> filter) since both operations this
         feature performs (getLaunchIntentForPackage AND an explicit setPackage(...) ACTION_SEND)
         are package-identity checks, not "any app that can handle this intent" queries. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.barcelona" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Plan 4 Task 3: required to even ASK for POST_NOTIFICATIONS on API 33+, without this
         declaration requestPermission() would fail/no-op regardless of runtime checks. No-op
         (auto-granted, no runtime gate at all) below API 33, see NotificationPermissionCondition
         .PRE_33's own kdoc. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Plan 4 Task 4 (b): opts into the OS predictive-back gesture (system-driven swipe preview +
         animation) instead of the legacy onBackPressed()/KEYCODE_BACK dispatch. Declared at the
         <application> level (not per-activity) since MainActivity is this app's only activity — one
         declaration covers it. Android 15+ already enables predictive-back system animations by
         default for apps that set this flag; Android 16 (API 36, this app's targetSdk) goes further
         and enables them by default REGARDLESS, per developer.android.com/about/versions/16/
         behavior-changes-16 ("Predictive back system animations enabled by default; onBackPressed
         not called and KeyEvent.KEYCODE_BACK not dispatched") — this app never overrides
         onBackPressed()/dispatches KEYCODE_BACK manually (grep-verified against androidMain), so
         there is no legacy back-handling code this flag could silently break. Explicit here rather
         than relying on the API-36 default alone: minSdk is 26, and this flag is what makes the
         predictive-back gesture (not just the plain back-stack pop) available on every API level
         that supports it (33+), not only once running ON API 36+. -->
    <application
        android:label="TerraWatch"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        <!-- Plan 4 Task 3: singleTask, a digest notification's PendingIntent (FLAG_ACTIVITY_NEW_TASK,
             AlertDigestWorker.android.kt) must re-front the SAME existing MainActivity instance via
             onNewIntent when the app is already running, rather than stacking a second instance on
             top of it (the "standard" launch-mode default). -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
