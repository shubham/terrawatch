<?xml version="1.0" encoding="utf-8"?>
<!--
  Plan 5 Task 4/6 phase 2: adaptive icon foreground layer - the FINAL mark (dial + cardinal
  ticks + sweep needle + epicenter dot), replacing Plan 4 Task 7's shield+ring+dot design.
  Geometry matches store-assets/brand/final/terrawatch-mark.svg exactly (same 108x108 unit
  space, same coordinates) - see that file's own kdoc and final-rationale.md for the full merge
  rationale (G2's geometry + G4's dot color/size, with one hex correction against both source
  files' own stale-cited WarnInk value). Safe-zone confirmation (every element vs. the 66dp/r33
  circle that survives every OS adaptive-icon mask shape) is in final-rationale.md's own table -
  all four elements clear it with margin.

    - disc: Ink (#17222E), r27, the dial/scope face.
    - four cardinal ticks: Water (#D9E9F4) at 0.6 alpha, r23->r26, stroke 1.5dp, round cap.
    - sweep needle: Safe green (#2FA36B), center to (74.85,44.28), stroke 5.5dp, round cap.
    - epicenter dot: #B08A2E - G4's own original hex, per the user's 2026-08-16 override
      ("brighter dot wins over token-sync"). NOT the current core/ui Tokens.kt WarnInk value
      (#7A5B19) - this dot is now a disclosed, intentional exception to that token; see
      final-rationale.md for the full tension write-up. Center (38.4,63), r5.25.

  Disc and dot are each drawn as a single closed path via the standard "two arcs" circle
  construction (M <cx+r>,<cy> A r,r 0 1,1 <cx-r>,<cy> A r,r 0 1,1 <cx+r>,<cy> Z), same convention
  the previous ring/dot paths in this file already used. Ticks and the needle are simple
  stroked line paths (M x1,y1 L x2,y2) - VectorDrawable's pathData commands are a constrained
  subset of SVG's, so these transliterate directly from the SVG source.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!-- Disc: Ink, r27, center (54,54). -->
  <path
      android:pathData="M81,54 A27,27 0 1,1 27,54 A27,27 0 1,1 81,54 Z"
      android:fillColor="#FF17222E" />
  <!-- Four cardinal ticks: Water @ 0.6 alpha, r23->r26, drawn before the needle/dot. -->
  <path
      android:pathData="M77,54 L80,54"
      android:strokeColor="#FFD9E9F4"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeAlpha="0.6" />
  <path
      android:pathData="M54,77 L54,80"
      android:strokeColor="#FFD9E9F4"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeAlpha="0.6" />
  <path
      android:pathData="M31,54 L28,54"
      android:strokeColor="#FFD9E9F4"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeAlpha="0.6" />
  <path
      android:pathData="M54,31 L54,28"
      android:strokeColor="#FFD9E9F4"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeAlpha="0.6" />
  <!-- Sweep needle: Safe green, center (54,54) to (74.85,44.28). -->
  <path
      android:pathData="M54,54 L74.85,44.28"
      android:strokeColor="#FF2FA36B"
      android:strokeWidth="5.5"
      android:strokeLineCap="round" />
  <!-- Epicenter dot: #B08A2E (G4's original hex - user override 2026-08-16, NOT the current
       WarnInk token). Center (38.4,63), r5.25. -->
  <path
      android:pathData="M43.65,63 A5.25,5.25 0 1,1 33.15,63 A5.25,5.25 0 1,1 43.65,63 Z"
      android:fillColor="#FFB08A2E" />
</vector>
